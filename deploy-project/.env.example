# Docker Compose
FRONTEND_PORT=
TZ=

# MySQL
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# OpenAI-compatible LLM API
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Kakao login
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=

# Optional
YOUTUBE_API_KEY=
JAVA_OPTS=

# Frontend build-time values
# These are not injected into an already-built static image by Docker Compose.
# Rebuild deploy-project/frontend/dist with the deployment URL before docker compose build.
VITE_API_BASE_URL=
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=
